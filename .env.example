# Copy to .env and adjust. Never commit real secrets.

# Postgres (docker compose maps it to localhost:5441)
DATABASE_URL=postgres://creditly:creditly@localhost:5441/creditly
# Test database (created and migrated automatically by `npm test`)
TEST_DATABASE_URL=postgres://creditly:creditly@localhost:5441/creditly_test

APP_URL=http://localhost:3101

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Optional: Google OAuth is enabled only when both are set
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stripe. With STRIPE_API_BASE set, the app talks to stripe-mock and uses the
# built-in test checkout simulator. Remove STRIPE_API_BASE and use real
# sk_test_ keys + price ids for Stripe test mode.
STRIPE_SECRET_KEY=sk_test_123
STRIPE_API_BASE=http://localhost:12141
# Any string works with stripe-mock; with real Stripe use `stripe listen` output
STRIPE_WEBHOOK_SECRET=whsec_local_demo_secret
STRIPE_PRICE_PRO=
STRIPE_PRICE_PACK_500=

# Email: Mailpit in docker (UI on http://localhost:8041). Empty = log to console.
SMTP_HOST=localhost
SMTP_PORT=1041
MAIL_FROM="Creditly <no-reply@creditly.test>"

# AI: real Anthropic calls when set, otherwise the labelled demo provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# `npm run seed` creates admin@creditly.test with this password
SEED_ADMIN_PASSWORD=admin-demo-1234

# Public demo mode (internet-facing deployment): one-click demo sign-in, no URL
# fetching, frozen demo credentials, per-IP auth limits, no reset emails.
DEMO_PUBLIC=
# Header carrying the client IP (behind Cloudflare: cf-connecting-ip)
CLIENT_IP_HEADER=x-forwarded-for
# Where the stripe-mock checkout simulator posts webhooks. Defaults to
# APP_URL/api/stripe/webhook; on a server use the app's own address.
SIMULATOR_WEBHOOK_URL=
