# Copy to deploy/.env.vps on the server (never commit the real file).
CREDITLY_IMAGE=creditly:latest
PUBLIC_URL=https://creditly.longtn.shop
# A database used only by Creditly on the shared Postgres.
DATABASE_URL=postgres://creditly:CHANGE_ME@postgres:5432/creditly
AUTH_SECRET=
STRIPE_WEBHOOK_SECRET=
SEED_ADMIN_PASSWORD=
CLIENT_IP_HEADER=cf-connecting-ip
ANTHROPIC_API_KEY=
